{
  "name": "lennys-podcast-wisdom",
  "version": "2.0.0",
  "description": "MCP server that puts every episode of Lenny's Podcast inside Claude Code, Cursor, or any MCP client. Local full-text search, self-updating transcripts, no API keys.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "lennys-wisdom": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "sync": "tsx src/cli/sync.ts",
    "build:db": "tsx src/cli/build-db.ts",
    "smoke": "tsx tests/smoke/mcp-client.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluzername/lennys-quotes.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lenny",
    "podcast",
    "product-management",
    "ai",
    "claude"
  ],
  "author": "Evyatar Bluzer",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "gray-matter": "^4.0.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
